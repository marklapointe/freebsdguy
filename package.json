{
  "name": "mdweb",
  "private": true,
  "version": "1.0.0",
  "description": "MDWeb personal website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "setup": "tsx server/scripts/setup.ts",
    "change-password": "tsx server/scripts/change-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --reporter=list",
    "test:api-smoke": "bash scripts/api-smoke.sh",
    "regression:freebsd": "bash scripts/freebsd-package-round.sh",
    "regression:live": "bash scripts/regression-round.sh smoke",
    "docs:shots": "playwright test e2e/99-docs-screenshots.spec.ts --reporter=list"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/katex": "^0.16.8",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/sanitize-html": "^2.16.1",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "echarts": "^6.1.0",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.18.1",
    "lucide-react": "^0.575.0",
    "md-editor-rt": "^6.4.0",
    "mermaid": "^11.16.0",
    "multer": "^2.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.34.5",
    "tsx": "^4.19.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true
  }
}
