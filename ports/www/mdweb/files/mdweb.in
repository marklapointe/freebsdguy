#!/bin/sh

# PROVIDE: mdweb
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="mdweb"
rcvar="mdweb_enable"

load_rc_config $name

: ${mdweb_enable:="NO"}
# NOTE: do not set ${name}_user — FreeBSD rc.subr would su -m as that user,
# and daemon -u then fails (empty pidfile). We drop privs only via daemon -u.
: ${mdweb_runas:="www"}
: ${mdweb_group:="www"}
: ${mdweb_dir:="%%WWWDIR%%"}
: ${mdweb_port:="5173"}
: ${mdweb_env_file:="/usr/local/etc/mdweb/mdweb.env"}
# Legacy location (pre-1.0.1 docs) still honored when the canonical file is absent
: ${mdweb_env_file_legacy:="/usr/local/etc/mdweb.env"}
: ${mdweb_config_dir:="/usr/local/etc/mdweb"}
: ${mdweb_jwt_secret_file:="/usr/local/etc/mdweb/jwt.secret"}

pidfile="/var/run/mdweb/${name}.pid"
procname="%%LOCALBASE%%/bin/node"
command="/usr/sbin/daemon"

# Load JWT_SECRET and friends from env file when present
# -r: `service mdweb status` as a non-root user must not spew "Permission denied"
if [ -r "${mdweb_env_file}" ]; then
	. "${mdweb_env_file}"
elif [ -r "${mdweb_env_file_legacy}" ]; then
	. "${mdweb_env_file_legacy}"
fi

export NODE_ENV=production
export CONFIG_DIR="${mdweb_config_dir}"
export PORT="${mdweb_port}"
# The secret stays in a mode-0600 file. Do not export it or place it on argv.
unset JWT_SECRET
unset SESSION_SECRET
export JWT_SECRET_FILE="${mdweb_jwt_secret_file}"

# Root runs daemon; -u drops to www; -p writes child (node) pid for status.
# daemon inherits exported env; do not pass JWT_SECRET= on the env/argv line.
command_args="-f -p ${pidfile} -u ${mdweb_runas} \
	/usr/bin/env NODE_ENV=production CONFIG_DIR=${mdweb_config_dir} PORT=${mdweb_port} \
	${mdweb_dir}/node_modules/.bin/tsx ${mdweb_dir}/server/index.ts -p ${mdweb_port}"

start_precmd="mdweb_prestart"
stop_postcmd="mdweb_postclean"

mdweb_prestart()
{
	if [ ! -f "${mdweb_jwt_secret_file}" ]; then
		echo "${name}: JWT secret file missing: ${mdweb_jwt_secret_file} (mode 0600, owned by ${mdweb_runas})." >&2
		return 1
	fi
	_mode=$(stat -f '%Lp' "${mdweb_jwt_secret_file}" 2>/dev/null || stat -c '%a' "${mdweb_jwt_secret_file}" 2>/dev/null || echo '')
	case "${_mode}" in
	600|0600) ;;
	*)
		echo "${name}: ${mdweb_jwt_secret_file} must be mode 0600 (is ${_mode:-unknown})." >&2
		return 1
		;;
	esac

	install -d -o root -g wheel -m 0755 /var/run/mdweb
	# child process (www) must write the pidfile
	chown ${mdweb_runas}:${mdweb_group} /var/run/mdweb
	chmod 0755 /var/run/mdweb

	for d in /var/db/mdweb/posts /var/db/mdweb/posts/images /var/db/mdweb/themes; do
		if [ ! -d "${d}" ]; then
			install -d -o ${mdweb_runas} -g ${mdweb_group} -m 0755 "${d}"
		fi
	done
	# Service user must write config (theme / site settings) and users.json
	if [ -d "${mdweb_config_dir}" ]; then
		chown ${mdweb_runas}:${mdweb_group} "${mdweb_config_dir}" 2>/dev/null || true
		for f in config.json users.json; do
			if [ -f "${mdweb_config_dir}/${f}" ]; then
				chown ${mdweb_runas}:${mdweb_group} "${mdweb_config_dir}/${f}" 2>/dev/null || true
				chmod 0640 "${mdweb_config_dir}/${f}" 2>/dev/null || true
			fi
		done
	fi
	chown -R ${mdweb_runas}:${mdweb_group} /var/db/mdweb 2>/dev/null || true

	if [ -f "${pidfile}" ]; then
		_pid=$(cat "${pidfile}")
		if ! echo "${_pid}" | grep -q '^[0-9][0-9]*$'; then
			rm -f "${pidfile}"
		elif ! kill -0 "${_pid}" 2>/dev/null; then
			rm -f "${pidfile}"
		fi
	fi
}

mdweb_postclean()
{
	rm -f "${pidfile}"
}

run_rc_command "$1"
