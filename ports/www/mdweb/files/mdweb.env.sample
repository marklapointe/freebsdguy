# MDWeb environment (install as /usr/local/etc/mdweb/mdweb.env).
# Do not put JWT_SECRET in this file or on the command line.
# The process reads the secret from JWT_SECRET_FILE (default /usr/local/etc/mdweb/jwt.secret),
# which must be mode 0600 and owned by the service user (www).
#
#   umask 077
#   openssl rand -hex 32 > /usr/local/etc/mdweb/jwt.secret
#   chown www:www /usr/local/etc/mdweb/jwt.secret
#   chmod 0600 /usr/local/etc/mdweb/jwt.secret
