#!/bin/sh

# PROVIDE: mdweb
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="mdweb"
rcvar="mdweb_enable"

load_rc_config $name

: ${mdweb_enable:="NO"}
: ${mdweb_user:="www"}
: ${mdweb_dir:="/usr/local/www/MDWeb"}
: ${mdweb_port:=""}

pidfile="/var/run/${name}.pid"
procname="/usr/local/bin/node"
command="/usr/sbin/daemon"

# Handle optional port argument
if [ -n "${mdweb_port}" ]; then
    port_arg="-p ${mdweb_port}"
fi

# -f: run in foreground (daemon handles backgrounding)
# -p: write child pid to pidfile
# -r: restart child if it exits
# -u: run as user
command_args="-f -p ${pidfile} -r -u ${mdweb_user} /usr/bin/env NODE_ENV=production ${mdweb_dir}/node_modules/.bin/tsx ${mdweb_dir}/server/index.ts ${port_arg}"

start_precmd="mdweb_prestart"
stop_postcmd="mdweb_postclean"

mdweb_prestart() {
    if [ ! -d "/var/run" ]; then
        mkdir -p /var/run
    fi
    
    # Validation of existing pidfile
    if [ -f "${pidfile}" ]; then
        _pid=$(cat "${pidfile}")
        # Check if PID is a positive integer
        if ! echo "${_pid}" | grep -q '^[0-9]\+$'; then
            echo "Removing invalid pidfile: ${pidfile} (content: ${_pid})"
            rm -f "${pidfile}"
        elif ! kill -0 "${_pid}" 2>/dev/null; then
            # PID is not running, stale pidfile
            echo "Removing stale pidfile: ${pidfile}"
            rm -f "${pidfile}"
        fi
    fi
}

mdweb_postclean() {
    # Ensure pidfile is gone after stop
    rm -f "${pidfile}"
}

run_rc_command "$1"
